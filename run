#!/bin/bash

function init_bot(){

    rm ./bot.log

    if [ ! -d "./venv" ]; then
        python3 -m venv venv
        source ./venv/bin/activate
        pip3 install d20 slixmpp python-dotenv

    else
        source ./venv/bin/activate
    fi

    python3 ./main.py
}

if [[ $1 == "-r" ]]; then
    rm -rf ./venv/
else 
    init_bot
fi
